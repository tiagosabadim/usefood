# Copie para .env e preencha. Todos os apps leem este arquivo da raiz.
# Valores locais: rode `pnpm db:start` e copie a URL e a chave publicável exibidas.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=

# development | homologacao | producao
VITE_APP_ENV=development

# Opcional: erros vão para o Sentry quando preenchido.
VITE_SENTRY_DSN=
