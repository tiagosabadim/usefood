{
  "name": "usefood",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:admin": "turbo run dev --filter=@usefood/admin",
    "dev:garcom": "turbo run dev --filter=@usefood/garcom",
    "dev:web": "turbo run dev --filter=@usefood/web",
    "dev:console": "turbo run dev --filter=@usefood/console",
    "build": "turbo run build",
    "build:site": "turbo run build && node scripts/montar-site.mjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:migration": "supabase migration new",
    "db:types": "supabase gen types typescript --local > packages/db/src/database.types.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "supabase": "^2.119.0",
    "turbo": "^2.11.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
